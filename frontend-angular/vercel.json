{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/gestao-escolar/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-spring-production-5401a3f1.up.railway.app/api/:path*"
    },
    {
      "source": "/py-analytics/:path*",
      "destination": "https://python-analytics-production-0b901680.up.railway.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    },
    {
      "source": "/py-analytics/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ]
}
